{
  "compilerOptions": {
    "target": "ESNext",
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "lib": ["DOM", "ESNext"],
    "types": ["node"],
    "rootDir": "./",

    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@main/*": ["./src/main/*"],
      "@preload/*": ["./src/preload/*"],
      "@renderer/*": ["./src/renderer/*"]
    }
  },
  "exclude": ["node_modules"]
}
